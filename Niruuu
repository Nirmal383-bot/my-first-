<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="A birthday surprise made with love for Babe, from Niru.">
<title>Happy Birthday, Babe 💙</title>
<style>
:root{
  --bg:#020817; --navy:#061936; --blue:#8fd2ff; --ice:#eaf7ff;
  --muted:#a8c7e5; --glass:rgba(7,27,57,.72);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  min-height:100vh;color:var(--ice);background:var(--bg);
  font-family:Georgia,"Times New Roman",serif;overflow-x:hidden;
}
body:before{
  content:"";position:fixed;inset:0;z-index:-3;
  background:
    radial-gradient(circle at 15% 15%,rgba(47,154,255,.20),transparent 28%),
    radial-gradient(circle at 85% 75%,rgba(92,184,255,.16),transparent 32%),
    linear-gradient(145deg,#010612,#061a3a 55%,#010612);
}
.stars,.stars:after{position:fixed;inset:0;pointer-events:none;z-index:-2}
.stars{
  background-image:radial-gradient(#fff 1px,transparent 1px),radial-gradient(#9dd9ff 1px,transparent 1px);
  background-size:92px 92px,145px 145px;background-position:10px 20px,50px 80px;opacity:.27;
  animation:drift 24s linear infinite;
}
@keyframes drift{to{background-position:110px 130px,200px 30px}}
.wrap{width:min(1000px,92%);margin:auto}
.hero{min-height:100vh;display:grid;place-items:center;text-align:center;padding:25px}
.glass{
  background:var(--glass);border:1px solid rgba(143,210,255,.24);
  border-radius:30px;box-shadow:0 0 70px rgba(35,137,255,.16);
  backdrop-filter:blur(14px);
}
.hero-card{max-width:820px;padding:55px 28px}
.kicker{font:700 12px Arial,sans-serif;letter-spacing:5px;text-transform:uppercase;color:var(--blue)}
h1{font-size:clamp(48px,11vw,96px);margin:18px 0 10px;text-shadow:0 0 30px rgba(103,195,255,.6)}
.hero p{font-size:clamp(19px,4vw,29px);color:#cce9ff}
.btn{
  display:inline-block;margin-top:30px;padding:14px 25px;border-radius:999px;
  background:var(--blue);color:#031225;text-decoration:none;font:700 15px Arial,sans-serif;
  box-shadow:0 0 28px rgba(94,190,255,.4);transition:.25s
}
.btn:hover{transform:translateY(-3px) scale(1.03)}
section{padding:90px 0}
.title{text-align:center;font-size:clamp(34px,7vw,48px);margin-bottom:12px}
.note{text-align:center;color:var(--muted);font:15px Arial,sans-serif;margin-bottom:35px}
.letter{padding:34px;line-height:1.9;font-size:18px}
.letter p{margin-bottom:17px}.sign{text-align:right;color:var(--blue);font-size:25px;margin-top:24px}
.gallery{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:18px}
.photo{overflow:hidden;border-radius:24px;min-height:350px;border:1px solid rgba(143,210,255,.2);background:#061a37;box-shadow:0 15px 35px rgba(0,0,0,.2)}
.photo img{width:100%;height:100%;min-height:350px;display:block;object-fit:cover;transition:.5s}
.photo:hover img{transform:scale(1.04)}
.reasons{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px}
.reason{padding:26px;text-align:center;border-radius:22px;background:rgba(6,25,52,.72);border:1px solid rgba(143,210,255,.17)}
.reason .emoji{font-size:35px;margin-bottom:10px}
.reason h3{margin-bottom:7px}.reason p{color:#aac7e1;line-height:1.6;font:14px Arial,sans-serif}
.timeline{display:grid;gap:15px}
.memory{display:flex;gap:18px;align-items:flex-start;padding:23px;border-radius:20px;background:rgba(6,25,52,.68);border:1px solid rgba(143,210,255,.16)}
.memory .dot{font-size:27px}.memory h3{margin-bottom:6px}.memory p{color:#aac7e1;line-height:1.6;font:14px Arial,sans-serif}
.surprise{text-align:center;padding:45px 25px}
.gift{
  width:130px;height:105px;margin:25px auto 18px;position:relative;cursor:pointer;
  filter:drop-shadow(0 0 25px rgba(96,190,255,.45));transition:.25s
}
.gift:hover{transform:translateY(-5px) rotate(-2deg)}
.box{position:absolute;left:10px;right:10px;bottom:0;height:72px;background:#1671b7;border-radius:5px}
.lid{position:absolute;left:0;right:0;top:20px;height:24px;background:#3b9de0;border-radius:5px}
.ribbon-v{position:absolute;width:18px;height:105px;left:56px;top:0;background:#d9f2ff}
.bow{position:absolute;top:0;left:42px;font-size:38px}
.hidden{display:none}.reveal{animation:reveal .7s ease}
@keyframes reveal{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:none}}
.final{text-align:center;padding-bottom:110px}
.final h2{font-size:clamp(40px,8vw,72px);text-shadow:0 0 28px #55b9ff}
.final p{max-width:680px;margin:18px auto;color:#b8d5ed;font-size:18px;line-height:1.8}
footer{text-align:center;padding:25px;color:#5e7e9e;font:13px Arial,sans-serif}
.float{position:fixed;bottom:-30px;pointer-events:none;z-index:5;animation:float 7s linear forwards}
@keyframes float{0%{transform:translateY(0) scale(.8);opacity:0}15%{opacity:.7}100%{transform:translateY(-110vh) translateX(80px) scale(1.3);opacity:0}}
.confetti{position:fixed;top:-20px;z-index:20;pointer-events:none;animation:fall 3.5s linear forwards}
@keyframes fall{to{transform:translateY(110vh) rotate(720deg);opacity:0}}
@media(max-width:600px){section{padding:70px 0}.letter{padding:25px;font-size:17px}.memory{padding:19px}}
</style>
</head>
<body>
<div class="stars"></div>

<header class="hero">
  <div class="hero-card glass">
    <div class="kicker">A little surprise from Niru</div>
    <h1>Happy Birthday, Babe 💙</h1>
    <p>There is something special waiting for you...</p>
    <a class="btn" href="#letter">Open Your Surprise ✨</a>
  </div>
</header>

<main class="wrap">
<section id="letter">
  <h2 class="title">A Letter For You 💌</h2>
  <p class="note">Read it slowly — I wrote it especially for you.</p>
  <article class="letter glass">
    <p>Happy Birthday, Babe. 💙</p>
    <p>I don't always know the right words to say, but I want you to know how much you mean to me.</p>
    <p>I want to stay by your side, support you, make you laugh, and make many more beautiful memories with you. I hope we always understand each other and grow together.</p>
    <p>I really want to marry you someday and build a happy life together. I want us to share our dreams, our happiness, our silly moments, and everything that life brings us. For now, I just want to enjoy every moment I have with you and make it special.</p>
    <p>On your birthday, I just want to see you happy and smiling. I hope you achieve everything you dream about and have a beautiful life. Thank you for coming into my life and giving me so many special memories.</p>
    <p><strong>Happy Birthday, Babe. ❤️ I love you so much, and I hope you always stay happy. 🎂✨</strong></p>
    <div class="sign">— Niru 💙</div>
  </article>
</section>

<section>
  <h2 class="title">Our Memories 📸</h2>
  <p class="note">Two little moments I wanted to keep here forever.</p>
  <div class="gallery">
    <div class="photo"><img src="data:image/jpeg;base64," alt="A memory of Babe and Niru"></div>
    <div class="photo"><img src="data:image/png;base64," alt="A happy memory of Babe and Niru"></div>
    <div class="photo"><img src="data:image/jpeg;base64," alt="A portrait of Babe"></div>
  </div>
</section>

<section>
  <h2 class="title">A Few Things I Appreciate About You ✨</h2>
  <div class="reasons">
    <div class="reason"><div class="emoji">😊</div><h3>Your Smile</h3><p>It can make an ordinary moment feel special.</p></div>
    <div class="reason"><div class="emoji">💙</div><h3>Your Heart</h3><p>I appreciate the person you are and the way you care.</p></div>
    <div class="reason"><div class="emoji">🌙</div><h3>Our Memories</h3><p>The little moments are the ones I want to remember.</p></div>
    <div class="reason"><div class="emoji">✨</div><h3>Your Presence</h3><p>Having you in my life has made many days brighter.</p></div>
  </div>
</section>

<section>
  <h2 class="title">Our Little Story 🕰️</h2>
  <p class="note">The best part is that the story isn't finished.</p>
  <div class="timeline">
    <div class="memory"><div class="dot">🌱</div><div><h3>The Beginning</h3><p>Two people, a few moments, and the start of memories that became important.</p></div></div>
    <div class="memory"><div class="dot">📸</div><div><h3>The Memories</h3><p>Smiles, silly moments, and days that became part of our story.</p></div></div>
    <div class="memory"><div class="dot">🎂</div><div><h3>Today</h3><p>Today is your birthday — and you deserve to be celebrated.</p></div></div>
    <div class="memory"><div class="dot">🌟</div><div><h3>What Comes Next</h3><p>More growth, more memories, and hopefully many beautiful chapters ahead.</p></div></div>
  </div>
</section>

<section>
  <div class="surprise glass">
    <h2 class="title">One More Surprise 🎁</h2>
    <p class="note">Tap the gift.</p>
    <div class="gift" onclick="openGift()" aria-label="Open birthday gift">
      <div class="bow">🎀</div><div class="lid"></div><div class="ribbon-v"></div><div class="box"></div>
    </div>
    <div id="giftMessage" class="hidden">
      <h2 style="font-size:34px;margin-bottom:12px">You found it! 💙</h2>
      <p style="color:#b8d5ed;line-height:1.8;font-size:17px">Babe, I hope this little website makes you smile. Your birthday deserves more than a simple “Happy Birthday,” so I made you a tiny world of memories and wishes.</p>
    </div>
  </div>
</section>

<section class="final">
  <h2>Happy Birthday, Babe 💙</h2>
  <p>May this new year of your life bring you happiness, confidence, beautiful opportunities, and lots of reasons to smile.</p>
  <p>And from Niru: here's to making many more memories together. ✨</p>
  <button class="btn" onclick="celebrate()">Celebrate 🎉</button>
</section>
</main>

<footer>Made specially by Niru for Babe 💙</footer>

<script>
function floatHeart(){
  const e=document.createElement("div"); e.className="float";
  e.textContent=["💙","✨","♡"][Math.floor(Math.random()*3)];
  e.style.left=Math.random()*100+"vw";
  e.style.fontSize=(16+Math.random()*18)+"px";
  e.style.animationDuration=(5+Math.random()*5)+"s";
  document.body.appendChild(e); setTimeout(()=>e.remove(),10000);
}
setInterval(floatHeart,900);

function openGift(){
  const m=document.getElementById("giftMessage");
  m.classList.remove("hidden"); m.classList.add("reveal");
  celebrate();
}
function celebrate(){
  const chars=["💙","✨","🎉","🎂","⭐","♡"];
  for(let i=0;i<45;i++){
    const e=document.createElement("div"); e.className="confetti";
    e.textContent=chars[Math.floor(Math.random()*chars.length)];
    e.style.left=Math.random()*100+"vw";
    e.style.fontSize=(14+Math.random()*20)+"px";
    e.style.animationDelay=Math.random()*.8+"s";
    document.body.appendChild(e); setTimeout(()=>e.remove(),4500);
  }
}
</script>
</body>
</html>
